{
  "name": "mindforge",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "build": {
    "appId": "com.mindforge.app",
    "productName": "MindForge",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist",
      "electron",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/.*",
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "npmRebuild": false
  },
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "electron-builder",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "cross-env NODE_ENV=development electron .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@antv/g6": "^5.0.49",
    "@excalidraw/excalidraw": "^0.15.0",
    "@milkdown/crepe": "^7.15.2",
    "@milkdown/preset-gfm": "^7.15.2",
    "@milkdown/theme-nord": "^7.15.2",
    "@milkdown/vue": "^7.15.2",
    "@tiptap/starter-kit": "^3.0.7",
    "@tiptap/vue-3": "^3.0.7",
    "axios": "^1.11.0",
    "chokidar": "^4.0.3",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "dhtmlx-gantt": "^9.0.14",
    "dompurify": "^3.2.6",
    "electron-store": "^10.1.0",
    "element-plus": "^2.10.4",
    "express": "^5.1.0",
    "html2pdf": "^0.0.11",
    "html2pdf.js": "^0.10.3",
    "jspdf-font": "^1.0.7",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "marked": "^16.1.1",
    "markmap-lib": "^0.18.12",
    "mind-elixir": "^5.0.4",
    "pdf-annotate.js": "github:instructure/pdf-annotate.js",
    "pdfjs-dist": "^3.11.174",
    "pinia": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-mind-map": "^0.14.0-fix.1",
    "three": "^0.179.1",
    "vditor": "^3.11.1",
    "vue": "^3.5.17",
    "vue-ganttastic": "^0.9.34",
    "vue-konva": "^3.2.2",
    "vue-pdf-embed": "^2.1.3",
    "vue-router": "^4.5.1",
    "vue3-pdfjs": "^0.1.6",
    "vuetify": "^3.9.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^10.0.0",
    "electron": "^34.5.8",
    "electron-builder": "^26.0.12",
    "gulp": "^5.0.1",
    "gulp-ttf2woff2": "^5.0.0",
    "jspdf": "^3.0.1",
    "less": "^4.4.0",
    "sass-embedded": "^1.90.0",
    "vite": "^7.0.4",
    "vue-cli-plugin-vuetify": "~2.5.8"
  }
}
